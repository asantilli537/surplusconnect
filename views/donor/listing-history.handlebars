<div class="page-header">
  <div class="page-header-inner">
    <div>
      <h1 class="page-title">donation history</h1>
      <p class="page-subtitle">
        a full record of every listing you have posted
      </p>
    </div>
    <a href="/donor/dashboard" class="btn btn-ghost">
      &larr; back to dashboard
    </a>
  </div>
</div>

<div class="container">

  {{#if hasPastDonations}}
    <div class="history-table-wrap card">
      <table class="history-table" role="table">
        <thead>
          <tr>
            <th scope="col">listing title</th>
            <th scope="col">food category</th>
            <th scope="col">items</th>
            <th scope="col">claimed by</th>
            <th scope="col">posted</th>
            <th scope="col">completed</th>
            <th scope="col">status</th>
          </tr>
        </thead>
        <tbody>
          {{#each pastDonations}}
            <tr class="history-row">
              <td class="history-title">{{this.title}}</td>
              <td>{{this.foodCategory}}</td>
              <td class="history-items-count">
                {{this.items.length}} item{{#if_gt this.items.length 1}}s{{/if_gt}}
              </td>
              <td>
                {{#if this.claimedBy}}
                  {{this.claimedBy}}
                {{else}}
                  <span class="text-muted">unclaimed</span>
                {{/if}}
              </td>
              <td>{{this.postedAt}}</td>
              <td>
                {{#if this.completedOn}}
                  {{this.completedOn}}
                {{else}}
                  <span class="text-muted">pending</span>
                {{/if}}
              </td>
              <td>
                <span class="badge badge-{{this.status}}">
                  {{this.status}}
                </span>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <div class="empty-state empty-state--large">
      <p class="empty-state-text">
        you haven't posted any listings yet
      </p>
      <a href="/listings/create" class="btn btn-primary">
        post your first listing
      </a>
    </div>
  {{/if}}

</div>