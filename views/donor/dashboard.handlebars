<div class="page-header">
  <div class="page-header-inner">
    <div>
      <h1 class="page-title">good morning, {{user.firstName}}</h1>
      <p class="page-subtitle">here's what's happening with your donations today</p>
    </div>
    <a href="/listings/create" class="btn btn-primary">+ post a listing</a>
  </div>
</div>

<div class="container">

  <div class="dashboard-grid" style="margin-bottom: var(--space-10);">
    <div class="stat-card">
      <span class="stat-value">{{totalDonations}}</span>
      <span class="stat-label">total donations made</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{{activeCount}}</span>
      <span class="stat-label">active listings right now</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{{claimedCount}}</span>
      <span class="stat-label">listings claimed this month</span>
    </div>
  </div>

  <section class="dashboard-section" aria-labelledby="active-listings-heading">
    <div class="section-header">
      <h2 class="section-title" id="active-listings-heading">active listings</h2>
      <a href="/listings/create" class="btn btn-secondary btn-sm">post new</a>
    </div>

    {{#if hasActiveListings}}
      <div class="listings-grid" id="listings-grid">
        {{#each activeListings}}
          {{> listing-card listing=this showActions=true showClaimButton=false}}
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state">
        <p class="empty-state-text">you don't have any active listings right now</p>
        <a href="/listings/create" class="btn btn-primary btn-sm">post a new listing</a>
      </div>
    {{/if}}
  </section>

  <section class="dashboard-section" aria-labelledby="recent-heading">
    <div class="section-header">
      <h2 class="section-title" id="recent-heading">recent donations</h2>
      <a href="/donor/history" class="btn btn-ghost btn-sm">view all</a>
    </div>

    {{#if hasRecentDonations}}
      <div class="history-table-wrap card">
        <table class="history-table" role="table">
          <thead>
            <tr>
              <th scope="col">listing</th>
              <th scope="col">claimed by</th>
              <th scope="col">posted</th>
              <th scope="col">status</th>
              <th scope="col">actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each recentDonations}}
              <tr class="history-row">
                <td class="history-title">{{this.title}}</td>
                <td>
                  {{#if this.claimedById}}
                    <span class="text-muted">claimed</span>
                  {{else}}
                    <span class="text-muted">unclaimed</span>
                  {{/if}}
                </td>
                <td>{{formatDate this.postedAt}}</td>
                <td>
                  <span class="badge badge-{{this.status}}">{{this.status}}</span>
                </td>
                {{!--
                  showing chat and complaint links for claimed listings.
                  delivered listings only show chat since you cannot
                  file a complaint after the transaction is complete.
                --}}
                <td>
                {{#if this.transactionId}}
                  <div style="display:flex; flex-direction:column; gap: var(--space-2);">

                    {{!-- showing the PIN prominently for claimed listings so the donor
                        can share it verbally with the distributor at pickup --}}
                    {{#if_eq this.status 'claimed'}}
                      {{#if this.pickupPin}}
                        <div style="background:var(--color-bg-subtle,#f8f9fa); border:2px solid var(--color-primary); border-radius:var(--radius); padding:var(--space-2) var(--space-3); text-align:center;">
                          <span style="font-size:var(--text-xs); color:var(--color-text-muted); display:block; margin-bottom:2px;">pickup PIN</span>
                          <span style="font-family:monospace; font-size:var(--text-xl); font-weight:700; letter-spacing:0.2em; color:var(--color-primary);">{{this.pickupPin}}</span>
                          <span style="font-size:var(--text-xs); color:var(--color-text-muted); display:block; margin-top:2px;">share this at pickup</span>
                        </div>
                      {{/if}}
                    {{/if_eq}}

                    <a href="/chat/{{this.transactionId}}" class="btn btn-secondary btn-sm">open chat</a>
                    {{#if_eq this.status 'claimed'}}
                      <a href="/complaints/new?transactionId={{this.transactionId}}" class="btn btn-ghost btn-sm">file complaint</a>
                    {{/if_eq}}
                  </div>
                {{else}}
                  <span class="text-muted">n/a</span>
                {{/if}}
              </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="empty-state">
        <p class="empty-state-text">
          no completed donations yet. listings you post will show up here once they have been picked up.
        </p>
      </div>
    {{/if}}
  </section>

</div>