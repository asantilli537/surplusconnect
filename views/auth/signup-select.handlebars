<div class="auth-wrapper">
  <div class="auth-card auth-card--wide">

    <div class="auth-header">
      <h1 class="auth-title">join SurplusConnect</h1>
      <p class="auth-subtitle">choose the role that best describes you</p>
    </div>

    <div class="role-grid">

      <a href="/signup/donor" class="role-card">
        <span class="role-icon" aria-hidden="true">&#127968;</span>
        <h2 class="role-name">food donor</h2>
        <p class="role-desc">
          I run a restaurant, bakery, or food business and want to donate
          surplus food instead of throwing it away.
        </p>
        <span class="btn btn-secondary btn-sm role-cta">register as donor</span>
      </a>

      <a href="/signup/distributor" class="role-card">
        <span class="role-icon" aria-hidden="true">&#127968;</span>
        <h2 class="role-name">distributor</h2>
        <p class="role-desc">
          I represent a nonprofit or community organization and want to
          claim donated food for the people we serve.
        </p>
        <span class="btn btn-secondary btn-sm role-cta">register as distributor</span>
      </a>

      <a href="/signup/volunteer" class="role-card">
        <span class="role-icon" aria-hidden="true">&#128663;</span>
        <h2 class="role-name">volunteer courier</h2>
        <p class="role-desc">
          I want to help transport food donations between donors and
          organizations that need them.
        </p>
        <span class="btn btn-secondary btn-sm role-cta">register as volunteer</span>
      </a>

    </div>

    <div class="auth-footer">
      <p>already have an account? <a href="/login">sign in</a></p>
    </div>

  </div>
</div>