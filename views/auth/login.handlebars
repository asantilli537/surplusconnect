<div class="auth-wrapper">
  <div class="auth-card">

    <div class="auth-header">
      <h1 class="auth-title">welcome back</h1>
      <p class="auth-subtitle">sign in to your SurplusConnect account</p>
    </div>

    {{#if errorMessage}}
      <div class="flash-message flash-message--error" role="alert">
        <span class="flash-text">{{errorMessage}}</span>
      </div>
    {{/if}}

    <form class="auth-form form-stack" action="/login" method="POST" novalidate>

      <div class="form-group">
        <label class="form-label form-label--required" for="email">
          email address
        </label>
        <input
          class="form-input"
          type="email"
          id="email"
          name="email"
          placeholder="you@example.com"
          autocomplete="email"
          required
          value="{{prevEmail}}"
        />
        <span class="form-error" id="email-error" aria-live="polite"></span>
      </div>

      <div class="form-group">
        <label class="form-label form-label--required" for="password">
          password
        </label>
        <div class="input-password-wrap">
          <input
            class="form-input"
            type="password"
            id="password"
            name="password"
            placeholder="enter your password"
            autocomplete="current-password"
            required
          />
          <button
            type="button"
            class="password-toggle"
            aria-label="show password"
            data-target="password"
          >
            &#128065;
          </button>
        </div>
        <span class="form-error" id="password-error" aria-live="polite"></span>
      </div>

      <button type="submit" class="btn btn-primary btn-lg auth-submit">
        sign in
      </button>

    </form>

    <div class="auth-footer">
      <p>don't have an account? <a href="/signup">get started here</a></p>
    </div>

  </div>
</div>