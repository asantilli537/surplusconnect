<div class="page-header">
  <div class="page-header-inner">
    <div>
      <h1 class="page-title">welcome back, {{user.firstName}}</h1>
      <p class="page-subtitle">manage your claimed pickups and find new listings nearby</p>
    </div>
    <a href="/listings" class="btn btn-primary">browse listings</a>
  </div>
</div>

{{!--
  showing a persistent but non-blocking banner for distributors
  whose EIN could not be verified at signup. this does not prevent
  platform use but makes the pending status visible.
--}}
{{#unless isVerified}}
  <div class="container" style="padding-top: var(--space-4);">
    <div class="flash-message flash-message--warning" role="alert">
      <span class="flash-text">
        your organization's EIN has not been verified against the IRS
        501(c)(3) database. you can still browse and claim listings.
        contact <a href="mailto:support@surplusconnect.org">support@surplusconnect.org</a>
        to complete verification.
      </span>
    </div>
  </div>
{{/unless}}

<div class="container">

  <div class="dashboard-grid" style="margin-bottom: var(--space-10);">
    <div class="stat-card">
      <span class="stat-value">{{totalPickups}}</span>
      <span class="stat-label">total pickups completed</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{{activeClaimsCount}}</span>
      <span class="stat-label">active claims right now</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{{monthPickups}}</span>
      <span class="stat-label">pickups this month</span>
    </div>
  </div>

  <section class="dashboard-section" aria-labelledby="claimed-heading">
    <div class="section-header">
      <h2 class="section-title" id="claimed-heading">your active claims</h2>
      <a href="/listings" class="btn btn-secondary btn-sm">find more</a>
    </div>

    {{#if hasClaimedListings}}
      <div class="listings-grid">
        {{#each claimedListings}}
          <div class="listing-card listing-card--claimed">

            <div class="listing-card-header">
              <div class="listing-card-meta">
                <span class="badge badge-claimed">claimed</span>
                <span class="listing-category">{{this.foodCategory}}</span>
              </div>
            </div>

            <div class="listing-card-body">
              <h3 class="listing-title">{{this.title}}</h3>

              {{#if this.description}}
                <p class="listing-description">{{this.description}}</p>
              {{/if}}

              <ul class="listing-items" aria-label="food items">
                {{#each this.items}}
                  <li class="listing-item">
                    <span class="listing-item-name">{{this.name}}</span>
                    <span class="listing-item-qty">{{this.quantity}} {{this.unit}}</span>
                  </li>
                {{/each}}
              </ul>

              <div class="listing-pickup-info">
                <span class="pickup-label">pickup window</span>
                <span class="pickup-time">{{formatDate this.pickupStartTime}} &mdash; {{formatDate this.pickupEndTime}}</span>
              </div>

              {{#if this.pickupAddress}}
                <div class="listing-location">
                  <span class="location-text">{{this.pickupAddress.street}}, {{this.pickupAddress.city}}, {{this.pickupAddress.state}}</span>
                </div>
              {{/if}}
            </div>

            {{!--
              primary actions: open chat, PIN verification, and file complaint.
              the mark delivered button is replaced by a PIN entry form.
              the distributor must enter the PIN they received verbally from
              the donor at pickup before the delivery can be confirmed.
            --}}
            <div class="listing-card-footer" style="flex-direction:column; align-items:stretch;">
              {{#if this.transactionId}}
                <a href="/chat/{{this.transactionId}}" class="btn btn-primary btn-sm">open chat</a>

            <form action="/transactions/{{this.transactionId}}/verify-pin" method="POST" class="pin-verify-form" style="margin-top:var(--space-2);">
              <input type="hidden" name="listingId" value="{{this._id}}" />
                  <div style="display:flex; gap:var(--space-2); align-items:center;">
                    <input
                      type="text"
                      name="enteredPin"
                      placeholder="PIN"
                      maxlength="4"
                      pattern="[0-9]{4}"
                      inputmode="numeric"
                      autocomplete="off"
                      style="width:80px; font-family:monospace; font-size:var(--text-lg); letter-spacing:0.2em; text-align:center; padding:var(--space-2); border:1px solid var(--color-border); border-radius:var(--radius);"
                      aria-label="enter the 4-digit pickup PIN from the donor"
                    />
                    <button type="submit" class="btn btn-secondary btn-sm" style="flex:1;">confirm pickup</button>
                  </div>

                  {{!-- showing PIN error only for the specific card that failed --}}
                  {{#if_eq ../pinErrorListingId this._id}}
                    <p style="color:#dc2626; font-size:var(--text-sm); margin-top:var(--space-1);">
                      {{../pinError}}
                    </p>
                  {{/if_eq}}
                </form>

                <a href="/complaints/new?transactionId={{this.transactionId}}" class="btn btn-ghost btn-sm">file complaint</a>
              {{else}}
                <span class="listing-claimed-note">claimed</span>
              {{/if}}
            </div>

          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state">
        <p class="empty-state-text">you have no active claims right now</p>
        <a href="/listings" class="btn btn-primary btn-sm">browse available listings</a>
      </div>
    {{/if}}
  </section>

  <section class="dashboard-section" aria-labelledby="recent-pickups-heading">
    <div class="section-header">
      <h2 class="section-title" id="recent-pickups-heading">recent pickups</h2>
      <a href="/distributor/history" class="btn btn-ghost btn-sm">view all</a>
    </div>

    {{#if hasRecentPickups}}
      <div class="history-table-wrap card">
        <table class="history-table" role="table">
          <thead>
            <tr>
              <th scope="col">listing</th>
              <th scope="col">donor</th>
              <th scope="col">completed</th>
              <th scope="col">status</th>
            </tr>
          </thead>
          <tbody>
            {{#each recentPickups}}
              <tr class="history-row">
                <td class="history-title">{{this.title}}</td>
                <td>{{this.donorName}}</td>
                <td>{{formatDate this.completedOn}}</td>
                <td><span class="badge badge-delivered">delivered</span></td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="empty-state">
        <p class="empty-state-text">no completed pickups yet. claim a listing to get started.</p>
      </div>
    {{/if}}
  </section>

</div>