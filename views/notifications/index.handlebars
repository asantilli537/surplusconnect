<div class="page-header">
  <div class="page-header-inner">
    <div>
      <h1 class="page-title">notifications</h1>
      <p class="page-subtitle">
        updates on your listings, pickups, and account activity
      </p>
    </div>
  </div>
</div>

<div class="container">
  <div class="notifications-wrap">

    {{#if notifications.length}}
      <div class="notifications-list">
        {{#each notifications}}
          <div
            class="notification-item {{#unless this.isRead}}notification-item--unread{{/unless}}"
            data-notification-id="{{this._id}}"
          >
            <div class="notification-content">
              <p class="notification-message">{{this.message}}</p>
              <span class="notification-time">{{this.sentTime}}</span>
            </div>
            {{#unless this.isRead}}
              <span class="notification-dot" aria-label="unread"></span>
            {{/unless}}
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state empty-state--large">
        <p class="empty-state-text">you're all caught up. no notifications yet.</p>
      </div>
    {{/if}}

  </div>
</div>